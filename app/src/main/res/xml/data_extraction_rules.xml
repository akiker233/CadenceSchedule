<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ 备份/换机规则。

   与 fullBackupContent（res/xml/backup_rules.xml）保持一致：
   - 课表数据保留在云备份与设备间迁移中（换机后直接可用）；
   - WebDAV 凭据、设备 UUID、可重新下载的脚本缓存一律排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="webdav_config.xml" />
        <exclude domain="sharedpref" path="stats_prefs.xml" />
        <exclude domain="file" path="repo" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="webdav_config.xml" />
        <exclude domain="sharedpref" path="stats_prefs.xml" />
        <exclude domain="file" path="repo" />
    </device-transfer>
</data-extraction-rules>
