# Nexio课程表 - Git 忽略规则

# --- Android / Gradle 构建输出 ---
/build
app/build
app/release
local.properties

# --- IDE 配置 ---
.idea/
*.iml
*.iws

# --- Kotlin 编译缓存 ---
.kotlin/

# --- OS 文件 ---
.DS_Store
Thumbs.db

# --- 签名文件（敏感信息！） ---
keystore/

# --- 部署相关（敏感：SSH 私钥） ---
.deploy/

# --- 后端服务（独立部署到 ECS，不进公开仓库） ---
server/

# --- Gradle 包装器缓存 ---
.gradle/

# --- 工作区本地 Gradle 缓存（沙箱/受限环境下用 GRADLE_USER_HOME 指向此处）---
.gradle-dev/

# --- DSH 工作区权限修复的备份与报告 ---
.dsh-acl-recovery/

# --- 受限环境专用的 Gradle 初始化脚本（本机验证用，非项目配置）---
gradle-dev-init.gradle.kts

# --- 其他 ---
/captures
.externalNativeBuild
.cxx
temp_*/

# --- 教务索引（release 构建由 downloadEduIndex 从 gitee 拉取，勿提交） ---
app/src/main/assets/eduloader/school_index.pb

# --- 工作助手本地目录 ---
.workbuddy/

